# Public URL of your deployed site. Used for canonical URLs, sitemap, Open Graph and share links.
# Local development works without changing this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets: where form submissions are saved. See google-apps-script/SETUP.md
# Keep these secret: never prefix them with NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Meta (Facebook/Instagram) Pixel ID, digits only, from Events Manager → your dataset.
# Leave empty to turn the Pixel off. Tracks PageView, Contact (WhatsApp/phone/email taps)
# and Lead (successful form submissions).
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID, from GA4 → Admin → Data streams → your web stream (starts with G-).
# Leave empty to turn GA off. Tracks page views, generate_lead (successful form submissions)
# and contact (WhatsApp/phone/email taps).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
